# ================================================================
# Autonomous Software Engineer Agent - Environment Configuration
# ================================================================
# Copy this file to '.env' and fill in your API keys:
#   cp .env.example .env

# ----------------------------------------------------------------
# LLM Provider (Set at least one)
# ----------------------------------------------------------------

# Option 1: OpenRouter (Recommended - access to Llama 3.1/3.3, Claude, GPT-4, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 2: Groq (Ultra-fast inference for open-weight models)
# GROQ_API_KEY=your_groq_api_key_here

# Option 3: OpenAI (Official OpenAI API)
# OPENAI_API_KEY=your_openai_api_key_here

# ----------------------------------------------------------------
# Optional Tool Integrations
# ----------------------------------------------------------------

# Serper API Key (Enables real-time Google search via do_search tool)
# Get a free key at https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# ----------------------------------------------------------------
# Optional Overrides
# ----------------------------------------------------------------

# Model override (Defaults: OpenRouter -> meta-llama/llama-3.1-8b-instruct, Groq -> llama-3.3-70b-versatile)
# AGENT_MODEL=meta-llama/llama-3.1-8b-instruct

# Base URL override (If using a local Ollama or custom OpenAI-compatible server)
# OPENAI_BASE_URL=http://localhost:11434/v1
